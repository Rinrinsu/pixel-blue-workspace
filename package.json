{
  "name": "pixel-blue-workspace",
  "version": "1.0.1",
  "description": "A pixel-blue visual workspace for notes, projects, tasks, daily notes, and knowledge workflows.",
  "main": "main.js",
  "scripts": {
    "build:styles": "node tools/build-styles.mjs",
    "bridge:codex": "node bridge/codex-bridge.mjs",
    "dev": "node tools/build-styles.mjs && node esbuild.config.mjs",
    "build": "node tools/build-styles.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:bridge": "node tools/codex-bridge-smoke.mjs",
    "test:search": "node tools/search-smoke.mjs",
    "test:project": "node tools/project-model-smoke.mjs",
    "test:editor": "node tools/editor-model-smoke.mjs",
    "test:ai": "node tools/ai-service-smoke.mjs",
    "test:juicer-review": "node tools/juicer-review-smoke.mjs",
    "test:global-theme": "node tools/global-theme-smoke.mjs",
    "verify:release": "node tools/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "dashboard",
    "tasks",
    "timeline"
  ],
  "author": "Rin",
  "license": "MIT",
  "dependencies": {
    "@openai/codex-sdk": "^0.145.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "latest",
    "typescript": "^5.7.2"
  }
}
